<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Swipe down opens the notification shade (StatusBarManager). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Today card: remaining events of the day, read-only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Search bar: people by name. Asked by a tap on the people row, never by typing; Home works without it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Needs-you card: the approvals app's read-only provider. The name is the one Home proposes to that app (its N1);
         it is signature-protected there, so it is granted only when both apps share a signer. -->
    <uses-permission android:name="com.yehor.approvals.permission.READ_NEEDS_YOU" />

    <!-- Homelab card: one read-only GET to Gatus on the tailnet (see res/xml/network_security_config.xml). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Earbud battery of the current audio output; asked once, the card works without it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Voice: bind tin's VoiceService. Signature-protected there, so it is granted only when both apps share a signer. -->
    <uses-permission android:name="io.github.egoushka.tin.permission.VOICE" />

    <!-- LauncherApps only returns activities this package can see. -->
    <queries>
        <!-- tin's VoiceService is bound by component name; on API 30+ that needs tin to be visible. -->
        <package android:name="io.github.egoushka.tin" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TinHome">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Notification glance; the grant also lets Home read active media sessions. -->
        <service
            android:name=".signals.TinListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
